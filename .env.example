# ===================================================
# NEXUS CAMPUS OS - ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================

# Environment mode ('development' or 'production')
NODE_ENV=production

# Public canonical URL (set this to your Vercel deployment URL, e.g. https://nexus-campus.vercel.app)
NEXT_PUBLIC_APP_URL=https://nexus-campus.vercel.app

# Session Security Key (used for cryptographic token salting)
SESSION_SECRET=nexus_campus_super_secure_session_secret_2026_production

# ===================================================
# FIREBASE CLIENT CONFIGURATION (Public)
# ===================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===================================================
# FIREBASE ADMIN SDK CONFIGURATION (Private / Server)
# ===================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
